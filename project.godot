[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="Player"
2d_physics/layer_2="ControlDevice"
2d_physics/layer_3="CollisionLayer"
2d_physics/layer_4="Watchtower"

[physics]

common/enable_pause_aware_picking=true

[rendering]

2d/snapping/use_gpu_pixel_snap=true
environment/default_clear_color=Color( 0.0627451, 0.0862745, 0.0980392, 1 )
environment/default_environment="res://default_env.tres"
